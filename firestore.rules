rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isEmailAdmin() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() == 'pbprosen1971@gmail.com';
    }

    function isAdmin() {
      return isEmailAdmin();
    }

    // 1. Users Collection (RBAC Protected against self-escalation)
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.auth.uid == userId || isEmailAdmin()) && (
        isEmailAdmin() || !('role' in request.resource.data) || request.resource.data.role == 'student'
      );
      allow update: if isAuthenticated() && (
        isEmailAdmin() ||
        (request.auth.uid == userId && (
          !('role' in request.resource.data) ||
          request.resource.data.role == resource.data.role ||
          request.resource.data.role == 'student'
        ))
      );
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isEmailAdmin());
    }

    match /Users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.auth.uid == userId || isEmailAdmin()) && (
        isEmailAdmin() || !('role' in request.resource.data) || request.resource.data.role == 'student'
      );
      allow update: if isAuthenticated() && (
        isEmailAdmin() ||
        (request.auth.uid == userId && (
          !('role' in request.resource.data) ||
          request.resource.data.role == resource.data.role ||
          request.resource.data.role == 'student'
        ))
      );
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isEmailAdmin());
    }

    // 2. Exams Collections (Upcoming, Live, and Question Content)
    match /exams/{examId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exam/{examId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Exam/{examId} {
      allow read: if true;
      allow write: if isAdmin();

      match /questions/{questionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Question Banks (Ministry & Standalone)
    match /ministryQuestionBanks/{bankId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /MinistryQuestionBanks/{bankId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /QuestionBank/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questionBank/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Site Settings (Upcoming exam countdown, notices, deletion registry)
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Results & Leaderboards
    match /results/{resultId} {
      // Results are readable for national merit leaderboard and test solutions
      allow read: if true;
      // Authenticated students can submit their own exam results
      allow create: if isAuthenticated();
      // Only admins can alter or delete test results
      allow update, delete: if isAdmin();
    }

    // 6. Payments & Manual Payment Requests: Private Financial Data
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.uid == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /paymentRequests/{requestId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.uid == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // 7. Study Materials (PDF Resources)
    match /studyMaterials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /materialAccess/{accessId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 8. Daily Practice Sessions & Results (Scoped to owner)
    match /dailyPractice/{practiceId} {
      allow get: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 9. Wrong Questions (Personal to each user)
    match /wrongQuestions/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      match /questions/{questionId} {
        allow get, list: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow update, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // 10. Referrals System
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.referrerId || 
        request.auth.uid == resource.data.referredUserId || 
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 11. Push Notifications
    match /fcmTokens/{tokenId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 12. Account Deletion Requests (Google Play & Privacy Compliance)
    match /accountDeletionRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 13. Job Examination Results (চাকরি পরীক্ষার ফলাফল)
    match /jobresult/{resultId} {
      allow read: if true;
      allow write: if isAdmin();

      match /rolls/{rollNumber} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // 14. Articles & Editorial Content (আর্টিকেল ও গাইডলাইন)
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default Catch-All: Block any unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
