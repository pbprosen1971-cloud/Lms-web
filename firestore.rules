rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Exams Collection (legacy and general)
    match /exams/{examId} {
      allow read, write: if true;
    }

    // Dedicated /exam collection (Upcoming Exam / Exam Schedule)
    match /exam/{examId} {
      allow read, write: if true;
    }

    // Dedicated /Exam collection (Actual Exam Content) and nested questions
    match /Exam/{examId} {
      allow read, write: if true;

      match /questions/{questionId} {
        allow read, write: if true;
      }
    }

    // Questions Collection
    match /questions/{questionId} {
      allow read, write: if true;
    }

    // Results Collection
    match /results/{resultId} {
      allow read, write: if true;
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Ministry Question Banks Collection
    match /ministryQuestionBanks/{bankId} {
      allow read, write: if true;
    }

    // Site Settings Collection (e.g. siteSettings/upcomingExam)
    match /siteSettings/{settingId} {
      allow read, write: if true;
    }

    // Default catch-all rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}



