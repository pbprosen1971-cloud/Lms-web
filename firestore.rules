rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Exams Collection (legacy and general)
    match /exams/{examId} {
      allow read, write: if true;
    }

    // Dedicated /exam collection (Upcoming Exam / Exam Schedule)
    match /exam/{examId} {
      allow read, write: if true;
    }

    // Dedicated /Exam collection (Actual Exam Content) and nested questions
    match /Exam/{examId} {
      allow read, write: if true;

      match /questions/{questionId} {
        allow read, write: if true;
      }
    }

    // Questions Collection
    match /questions/{questionId} {
      allow read, write: if true;
    }

    // Results Collection
    match /results/{resultId} {
      allow read, write: if true;
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Ministry Question Banks Collection
    match /ministryQuestionBanks/{bankId} {
      allow read, write: if true;
    }

    // Site Settings Collection (e.g. siteSettings/upcomingExam)
    match /siteSettings/{settingId} {
      allow read, write: if true;
    }

    // Referrals Collection
    match /referrals/{referralId} {
      allow read, write: if true;
    }

    // Study Materials Collection (PDF resources metadata)
    match /studyMaterials/{materialId} {
      allow read, write: if true;
    }

    // Material Access History Collection
    match /materialAccess/{accessId} {
      allow read, write: if true;
    }

    // Daily Practice Sessions & Results (Scoped to authenticated user's ID)
    match /dailyPractice/{practiceId} {
      allow get: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Wrong Questions (Personal to each user, scoped to request.auth.uid)
    match /wrongQuestions/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;

      match /questions/{questionId} {
        allow get, list: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAuthenticated() && request.auth.uid == userId && (request.resource.data.userId == request.auth.uid || !('userId' in request.resource.data));
        allow update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Default catch-all rule: Deny all unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}



