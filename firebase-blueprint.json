{
  "entities": {
    "users": {
      "title": "users",
      "description": "User profile collection",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "institution": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "accountStatus": { "type": "string", "enum": ["active", "blocked"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "isPremium": { "type": "boolean" },
        "inPremiumDate": { "type": "string" },
        "inPremiumExpiryDate": { "type": "string" },
        "referralCode": { "type": "string" },
        "referralCount": { "type": "number" },
        "referredBy": { "type": "string" },
        "referredAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "accountStatus"]
    },
    "exams": {
      "title": "exams",
      "description": "Exams collection",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "duration": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "totalMarks": { "type": "number" },
        "status": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "duration", "isPublished"]
    },
    "questions": {
      "title": "questions",
      "description": "Exam questions collection associated with examId",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "questionText": { "type": "string" },
        "optionA": { "type": "string" },
        "optionB": { "type": "string" },
        "optionC": { "type": "string" },
        "optionD": { "type": "string" },
        "correctAnswer": { "type": "string" },
        "explanation": { "type": "string" },
        "questionNumber": { "type": "number" }
      },
      "required": ["examId", "questionText", "optionA", "optionB", "optionC", "optionD", "correctAnswer"]
    },
    "results": {
      "title": "results",
      "description": "Exam performance records",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "examId": { "type": "string" },
        "examTitle": { "type": "string" },
        "score": { "type": "number" },
        "totalMarks": { "type": "number" },
        "percentage": { "type": "number" },
        "correctAnswers": { "type": "number" },
        "wrongAnswers": { "type": "number" },
        "skippedAnswers": { "type": "number" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "examTitle", "score", "totalMarks"]
    },
    "payments": {
      "title": "payments",
      "description": "Transaction and subscription payments",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "gateway": { "type": "string" },
        "transactionId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "gateway", "transactionId", "amount", "paymentStatus"]
    },
    "siteSettings": {
      "title": "siteSettings",
      "description": "Website global configuration such as upcoming exam banner and metadata",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "examId": { "type": "string" },
        "examDate": { "type": "string" },
        "startTime": { "type": "string" },
        "duration": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "subject": { "type": "string" },
        "totalQuestions": { "type": "number" },
        "totalMarks": { "type": "number" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "exam": {
      "title": "exam",
      "description": "Dedicated Upcoming Exam and Exam Schedule collection",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "examDateTime": { "type": "string" },
        "archiveDateTime": { "type": "string" },
        "examDate": { "type": "string" },
        "archiveDate": { "type": "string" },
        "examType": { "type": "string", "enum": ["free", "premium"] },
        "status": { "type": "string", "enum": ["upcoming", "live", "archive", "completed"] },
        "isPublished": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "subject": { "type": "string" },
        "duration": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "totalMarks": { "type": "number" }
      },
      "required": ["examId", "title", "status"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Actual examination content with subcollection questions",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "examType": { "type": "string" },
        "duration": { "type": "number" },
        "totalMarks": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["examId", "title"]
    },
    "referrals": {
      "title": "referrals",
      "description": "Referral tracking collection",
      "type": "object",
      "properties": {
        "referrerId": { "type": "string" },
        "referrerCode": { "type": "string" },
        "referredUserId": { "type": "string" },
        "referredUserName": { "type": "string" },
        "referredUserEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["referrerId", "referredUserId", "referrerCode"]
    },
    "studyMaterials": {
      "title": "studyMaterials",
      "description": "Study materials and PDF resources with Google Drive references",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "driveUrl": { "type": "string" },
        "driveFileId": { "type": "string" },
        "accessType": { "type": "string", "enum": ["free", "premium"] },
        "status": { "type": "string", "enum": ["draft", "published", "hidden"] },
        "displayOrder": { "type": "number" },
        "thumbnailUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "category", "driveUrl", "accessType", "status"]
    },
    "materialAccess": {
      "title": "materialAccess",
      "description": "User access and download history for study materials",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "materialId": { "type": "string" },
        "materialTitle": { "type": "string" },
        "category": { "type": "string" },
        "accessType": { "type": "string", "enum": ["free", "premium"] },
        "accessedAt": { "type": "string" }
      },
      "required": ["userId", "materialId", "accessType"]
    },
    "dailyPractice": {
      "title": "dailyPractice",
      "description": "Daily 10-MCQ practice sessions and completed results per user per day",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "dateKey": { "type": "string" },
        "questionIds": { "type": "array", "items": { "type": "string" } },
        "totalQuestions": { "type": "number" },
        "completed": { "type": "boolean" },
        "score": { "type": "number" },
        "correctAnswers": { "type": "number" },
        "wrongAnswers": { "type": "number" },
        "timeSpentSeconds": { "type": "number" },
        "createdAt": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["userId", "dateKey", "questionIds", "totalQuestions"]
    },
    "wrongQuestions": {
      "title": "wrongQuestions",
      "description": "Unique questions answered incorrectly by a user across exams",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "questionId": { "type": "string" },
        "questionText": { "type": "string" },
        "subject": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "correctAnswer": { "type": "number" },
        "explanation": { "type": "string" },
        "wrongCount": { "type": "number" },
        "status": { "type": "string", "enum": ["unmastered", "mastered"] },
        "addedAt": { "type": "string" },
        "lastWrongAt": { "type": "string" }
      },
      "required": ["userId", "questionId", "status", "wrongCount"]
    },
    "notifications": {
      "title": "notifications",
      "description": "System and admin broadcast notifications for users",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "url": { "type": "string" },
        "tag": { "type": "string" },
        "sentBy": { "type": "string" },
        "recipientCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "body", "createdAt"]
    },
    "fcmTokens": {
      "title": "fcmTokens",
      "description": "FCM device tokens for web push notifications",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userAgent": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["token", "createdAt"]
    }
  },
  "firestore": {
    "/notifications/{notificationId}": {
      "schema": "notifications",
      "description": "Broadcast notifications sent from admin to all users"
    },
    "/fcmTokens/{tokenId}": {
      "schema": "fcmTokens",
      "description": "User device registration tokens for push notifications"
    },
    "/dailyPractice/{practiceId}": {
      "schema": "dailyPractice",
      "description": "Daily 10-MCQ practice sessions and completed results scoped to each user per day"
    },
    "/wrongQuestions/{userId}": {
      "schema": "wrongQuestions",
      "description": "User wrong question container document scoped to authenticated user ID"
    },
    "/wrongQuestions/{userId}/questions/{questionId}": {
      "schema": "wrongQuestions",
      "description": "User specific wrong questions collection scoped to request.auth.uid"
    }
  }
}
