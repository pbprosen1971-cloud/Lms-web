{
  "entities": {
    "users": {
      "title": "users",
      "description": "User profile collection",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "institution": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "accountStatus": { "type": "string", "enum": ["active", "blocked"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "isPremium": { "type": "boolean" },
        "inPremiumDate": { "type": "string" },
        "inPremiumExpiryDate": { "type": "string" }
      },
      "required": ["uid", "email", "role", "accountStatus"]
    },
    "exams": {
      "title": "exams",
      "description": "Exams collection",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "duration": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "totalMarks": { "type": "number" },
        "status": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "duration", "isPublished"]
    },
    "questions": {
      "title": "questions",
      "description": "Exam questions collection associated with examId",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "questionText": { "type": "string" },
        "optionA": { "type": "string" },
        "optionB": { "type": "string" },
        "optionC": { "type": "string" },
        "optionD": { "type": "string" },
        "correctAnswer": { "type": "string" },
        "explanation": { "type": "string" },
        "questionNumber": { "type": "number" }
      },
      "required": ["examId", "questionText", "optionA", "optionB", "optionC", "optionD", "correctAnswer"]
    },
    "results": {
      "title": "results",
      "description": "Exam performance records",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "examId": { "type": "string" },
        "examTitle": { "type": "string" },
        "score": { "type": "number" },
        "totalMarks": { "type": "number" },
        "percentage": { "type": "number" },
        "correctAnswers": { "type": "number" },
        "wrongAnswers": { "type": "number" },
        "skippedAnswers": { "type": "number" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "examTitle", "score", "totalMarks"]
    },
    "payments": {
      "title": "payments",
      "description": "Transaction and subscription payments",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "gateway": { "type": "string" },
        "transactionId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "gateway", "transactionId", "amount", "paymentStatus"]
    },
    "siteSettings": {
      "title": "siteSettings",
      "description": "Website global configuration such as upcoming exam banner and metadata",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "examId": { "type": "string" },
        "examDate": { "type": "string" },
        "startTime": { "type": "string" },
        "duration": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "subject": { "type": "string" },
        "totalQuestions": { "type": "number" },
        "totalMarks": { "type": "number" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "exam": {
      "title": "exam",
      "description": "Dedicated Upcoming Exam and Exam Schedule collection",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "examDateTime": { "type": "string" },
        "archiveDateTime": { "type": "string" },
        "examDate": { "type": "string" },
        "archiveDate": { "type": "string" },
        "examType": { "type": "string", "enum": ["free", "premium"] },
        "status": { "type": "string", "enum": ["upcoming", "live", "archive", "completed"] },
        "isPublished": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "subject": { "type": "string" },
        "duration": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "totalMarks": { "type": "number" }
      },
      "required": ["examId", "title", "status"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Actual examination content with subcollection questions",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "examType": { "type": "string" },
        "duration": { "type": "number" },
        "totalMarks": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["examId", "title"]
    }
  }
}
